import "./style.css";

/**
 * Sent to the photographer when a client submits their selections.
 *
 * @email
 */
<html (
  photographer: string,
  clientName: string,
  galleryName: string,
  picks: string[],
  commentCount: number,
  url: string,
)>
  <body class="email selections-submitted">
    <div class="email-wrap">
      <p class="brand">proofloft</p>
      <h1>{clientName} sent their selections</h1>
      <p>
        Hi {photographer.split(" ")[0]}, {clientName} finished choosing from <strong>{galleryName}</strong>.
        They picked {picks.length} {picks.length === 1 ? "favorite" : "favorites"} and left {commentCount} {commentCount === 1 ? "comment" : "comments"}.
      </p>
      <p><a class="cta" href={url}>Review the selections</a></p>
      <div e:if={picks.length > 0} class="picks">
        <p class="label">Chosen files</p>
        <p class="files">{picks.join(", ")}</p>
      </div>
      <div class="email-footer">
        <p>Sent by proofloft on behalf of your client.</p>
      </div>
    </div>
  </body>
</html>
