import "./style.css";
import { File, ValidationError, redirect, session, sql } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AdminLayout } from "#app/shared/templates/admin-layout";
import { plural } from "#app/shared/services/galleries";
import { readDimensions, uploadPhotos } from "#app/shared/services/uploads";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Progress } from "@elements/ui/progress";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Field, FieldGroup, FieldLabel } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { DatePicker } from "@elements/ui/date-picker";
import { FileUpload } from "@elements/ui/file-upload";

export interface NewGallery {
  name: string;
  eventDate: string;
  clientName: string;
  clientEmail: string;
  password: string;
}

interface Form extends NewGallery {
  files: File[];
  error: string;
  saving: boolean;
  uploaded: number;
}

/** @rpc */
export function createGallery(form: NewGallery): string {
  session.isLoggedInOrThrow();

  let name = form.name.trim();

  if (!name) {
    throw new ValidationError("Give the gallery a name.");
  }

  if (!/^\d{4}-\d{2}-\d{2}$/.test(form.eventDate)) {
    throw new ValidationError("Pick the session date.");
  }

  let password = form.password.trim();

  return sql<{ id: string }>(`
    insert into galleries (userId, name, eventDate, clientName, clientEmail, passwordHash)
         values (${session.getOrThrow("userId")}, ${name}, ${form.eventDate}::date,
                 ${form.clientName.trim()}, ${form.clientEmail.trim().toLowerCase()},
                 case when ${password} = '' then null else crypt(${password}, genSalt('bf', 10)) end)
      returning id
  `).firstOrThrow().id;
}


async function onSubmit(form: Form) {
  form.saving = true;
  form.error = "";
  form.uploaded = 0;

  try {
    let id = createGallery({
      name: form.name,
      eventDate: form.eventDate,
      clientName: form.clientName,
      clientEmail: form.clientEmail,
      password: form.password,
    });

    // One photo per request keeps each request small and lets the count move.
    for (let f of form.files) {
      let d = await readDimensions(f);
      uploadPhotos({ galleryId: id, files: [f], dimensions: [d] });
      form.uploaded++;
    }

    redirect(`/admin/galleries/${id}`);
  } catch (err: any) {
    form.error = err.message;
    form.saving = false;
  }
}

function today(): string {
  return new Date().toISOString().slice(0, 10);
}

<html lang="en" class="page-new-gallery" (
  private form: Form = {
    name: "", eventDate: today(), clientName: "", clientEmail: "", password: "",
    files: [] as File[], error: "", saving: false, uploaded: 0,
  },
)>
  <head>
    <title>New gallery · proofloft</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AdminLayout active="new">
      <div class="new-gallery stack is-xl">
        <a class="link-muted text-sm" href="/admin">← All galleries</a>
        <div class="stack is-xs">
          <p class="eyebrow">New gallery</p>
          <h1>Create a proofing gallery</h1>
          <p class="lede">Name it, add the photos, then send the private link from the gallery page.</p>
        </div>

        <form onsubmit={() => onSubmit(form)}>
          <Card>
            <CardContent>
              <FieldGroup>
                <Field label="Gallery name">
                  <Input value={form.name} placeholder="Harper & Theo · Engagement" required />
                </Field>
  
                <Field label="Session date">
                  <DatePicker value={form.eventDate} required block />
                </Field>
  
                <Field>
                  <FieldLabel>Client name <span class="hint">optional</span></FieldLabel>
                  <Input value={form.clientName} placeholder="Harper Lin" />
                </Field>
  
                <Field>
                  <FieldLabel>Client email <span class="hint">optional</span></FieldLabel>
                  <Input type="email" value={form.clientEmail} placeholder="harper@example.com"
                         attrs={{ autocapitalize: "none", spellcheck: "false" }} />
                </Field>
  
                <Field>
                  <FieldLabel>Gallery password <span class="hint">optional</span></FieldLabel>
                  <Input value={form.password} placeholder="Leave blank to share by link only" attrs={{ autocomplete: "off" }} />
                </Field>
  
                <Field label="Photos">
                  <FileUpload files={form.files} accept={["image/jpeg", "image/png", "image/webp"]} maxFiles={Infinity}
                              maxFileSize={25_000_000} disabled={form.saving}
                              hint="Select as many as you like. JPEG, PNG or WebP, up to 25 MB each." />
                </Field>
  
                <Alert e:if={form.error} variant="danger" description={form.error} />
                <Progress e:if={form.saving && form.files.length > 0} value={form.uploaded} max={form.files.length} label="Uploading" showValue
                          getValueLabel={(v, max) => `${v} of ${max}`} />
              </FieldGroup>
            </CardContent>

            <CardFooter>
              <Button href="/admin" variant="ghost">Cancel</Button>
              <Button type="submit" variant="primary" loading={form.saving}>
                {form.files.length > 0 ? `Create with ${plural(form.files.length, "photo")}` : "Create gallery"}
              </Button>
            </CardFooter>
          </Card>
        </form>
      </div>
    </AdminLayout>
  </body>
</html>
