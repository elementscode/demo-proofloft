import "./style.css";

<Brand (href: string = "/admin")>
  <a class="brand" href={href}>
    <svg class="brand-mark" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="1.5" y="1.5" width="21" height="21" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/>
      <path d="M12 17.2s-5-3-5-6.6A2.7 2.7 0 0 1 12 9a2.7 2.7 0 0 1 5 1.6c0 3.6-5 6.6-5 6.6Z" fill="currentColor"/>
    </svg>
    <span>proofloft</span>
  </a>
</Brand>
