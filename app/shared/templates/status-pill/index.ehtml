import { Badge } from "@elements/ui/badge";
import { GalleryStatus } from "#app/shared/services/galleries";

type Variant = "secondary" | "info" | "warning" | "success";

const LABELS: Record<GalleryStatus, string> = {
  draft: "Draft",
  shared: "Shared",
  submitted: "Selections in",
  final: "Final",
};

const VARIANTS: Record<GalleryStatus, Variant> = {
  draft: "secondary",
  shared: "info",
  submitted: "warning",
  final: "success",
};

<StatusPill (status: GalleryStatus)>
  <Badge variant={VARIANTS[status]} dot>{LABELS[status]}</Badge>
</StatusPill>
